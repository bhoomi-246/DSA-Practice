class Solution {
    List<String> ans = new ArrayList<>();
    public List<String> generateParenthesis(int n) {
        generate("", 2 * n);
        return ans;
    }
    void generate(String curr, int len) {
        if (curr.length() == len) {
            if (isValid(curr)) {
                ans.add(curr);
            }
            return;
        }
        generate(curr + "(", len);
        generate(curr + ")", len);
    }
    boolean isValid(String s) {
        int balance = 0;
        for (char ch : s.toCharArray()) {

            if (ch == '(')
                balance++;
            else
                balance--;
            if (balance < 0)
                return false;
        }
        return balance == 0;
    }
}
