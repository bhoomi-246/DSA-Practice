class Solution {
    public int reverseDegree(String s) {
        int sum=0;
        //int value = ch-'a' + 1;
        for(int i=0;i<s.length();i++){
            char ch = s.charAt(i);
            int reverse = 'z'- ch + 1;
            sum+= reverse*(i+1);     
        }
        return sum;
    }
}
