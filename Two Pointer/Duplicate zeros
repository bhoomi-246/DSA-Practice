class Solution {
    public void duplicateZeros(int[] arr) {

        int n = arr.length;
        int[] result = new int[n];

        int j = 0;

        for (int i = 0; i < n && j < n; i++) {

            result[j] = arr[i];
            j++;

            if (arr[i] == 0 && j < n) {
                result[j] = 0;
                j++;
            }
        }

        for (int i = 0; i < n; i++) {
            arr[i] = result[i];
        }
    }
}
