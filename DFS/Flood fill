class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int newColor) {
        int original = image[sr][sc];
        if(original == newColor) return image;

        int m=image.length;
        int n=image[0].length;

        Queue<int[]>q = new LinkedList<>();
        q.add(new int[]{sr,sc});
        
        image[sr][sc]=newColor;
        int[][] dirs ={{1,0},{-1,0},{0,1},{0,-1}};
        while(!q.isEmpty()){
            int[] curr = q.poll();
            for(int[] d:dirs){
                int ni=curr[0]+d[0];
                int nj=curr[1]+d[1];
                if(ni>=0 && nj>=0 && ni<m && nj<n && image[ni][nj]==original){
                    q.add(new int[]{ni,nj});
                    image[ni][nj]=newColor;
                }
            }
        }
        return image;
    }
}
