class Solution {
    public boolean isRectangleOverlap(int[] rec1, int[] rec2) {
       int x1_1 = rec1[0];
       int y1_1 = rec1[1];
       int x2_1 = rec1[2];
       int y2_1 = rec1[3];

       int x1_2 = rec2[0];
       int y1_2 = rec2[1];
       int x2_2 = rec2[2];
       int y2_2 = rec2[3];
       
        int commonWidth = Math.min(x2_1, x2_2) - Math.max(x1_1, x1_2);
        int commonHeight = Math.min(y2_1, y2_2) - Math.max(y1_1, y1_2);
        if(commonWidth>0 && commonHeight>0){
            return true;
        } else{
            return false;
        } 
    }
}
